# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/task_app"

# Server Port
PORT=5000

# JSON Web Token Secret (replace with a long, random secret in production)
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"

# Frontend Application URL for CORS and Reset Links
FRONTEND_URL="http://localhost:5173"

# (Optional) SMTP Configuration for Nodemailer
# If omitted or empty, password reset links are automatically logged directly to the backend terminal
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_SECURE="false"
EMAIL_FROM="your-email@gmail.com"

